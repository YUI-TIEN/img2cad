{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://img2cad.local/schemas/case.schema.json",
  "title": "img2cad benchmark case",
  "type": "object",
  "required": ["schema_version", "case_id", "revision", "task_kind", "source_files", "requirements", "required_gates"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "task_kind": {"enum": ["photo_to_part", "drawing_to_part", "sketch_to_part"]},
    "supported": {"type": "boolean", "default": true},
    "source_files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["role", "path", "sha256"], "properties": {
        "role": {"enum": ["input_image", "reference_cad", "drawing", "other"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }, "additionalProperties": false},
      "contains": {"type": "object", "properties": {"role": {"enum": ["input_image", "drawing"]}}, "required": ["role"]}
    },
    "requirements": {
      "type": "object", "required": ["units", "dimensions"], "properties": {
        "units": {"type": "string", "minLength": 1},
        "dimensions": {"type": "array", "items": {"type": "object", "required": ["name", "value", "tolerance", "status"], "properties": {
          "name": {"type": "string"}, "value": {"type": "number"}, "tolerance": {"type": "number", "minimum": 0},
          "status": {"enum": ["user_confirmed", "drawing_dimension", "reference_measurement"]}
        }, "additionalProperties": false}},
        "expected_solid_count": {"type": ["integer", "null"], "minimum": 1},
        "notes": {"type": "string"}
      }, "additionalProperties": false
    },
    "required_gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["spec_valid", "model_build", "step_roundtrip", "explicit_dimensions", "visual_review"]}}
  },
  "additionalProperties": false
}
